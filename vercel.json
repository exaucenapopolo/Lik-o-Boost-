{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/dashboard.html"
    }
  ],
  "env": {
    "EXO_SUPPLIER_API_KEY": "@exo_supplier_api_key",
    "FIREBASE_SERVICE_ACCOUNT": "@firebase_service_account"
  }
}
